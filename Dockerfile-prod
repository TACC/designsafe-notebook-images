# Get OpenSees setup
ENV OPENSEES_DIR=${HOME}/.OpenSees
RUN mkdir ${HOME}/.OpenSees
COPY --from=taccaci/opensees:3.7.1 /usr/local/bin/OpenSees ${OPENSEES_DIR}/OpenSees
COPY --from=taccaci/opensees:3.7.1 /usr/local/bin/OpenSeesSP ${OPENSEES_DIR}/OpenSeesSP
