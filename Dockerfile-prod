FROM taccsciapps/ds-nb-img:base-0.1.5

USER root

ENV NB_USER=jupyter
ENV HOME=/home/jupyter

RUN pip uninstall --yes agavepy

RUN python -m pip install tapipy
RUN apt-get update \
    && apt-get -y install git \
    && apt-get -y install rsync

