RUN chown -R ${NB_USER}:${NB_GROUP} ${HOME} && \
    chmod 777 ${HOME} && \
    chmod 777 -R ${HOME}/.conda && \
    find ${HOME} -type f -exec chmod 666 {} \; && \
    find ${HOME} -type d -exec chmod 777 {} \;

